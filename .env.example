# Verion environment configuration
# Copy to backend/.env and frontend/.env for local development.

# --- Core ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-development-only

# --- API ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=verion

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Auth cookies ---
SESSION_COOKIE_NAME=verion_session
REFRESH_COOKIE_NAME=verion_refresh
ACCESS_TOKEN_MAX_AGE_SECONDS=900
REFRESH_TOKEN_MAX_AGE_SECONDS=604800

# --- GitHub (optional for local dev) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
# Required in production; optional in development (verification disabled when unset)
GITHUB_WEBHOOK_SECRET=

# --- LLM (optional) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Frontend ---
VITE_API_URL=
