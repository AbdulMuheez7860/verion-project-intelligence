ENVIRONMENT=development
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=verion
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
SECRET_KEY=change-me-in-development-only
DEBUG=true
FRONTEND_URL=http://localhost:5173
ACCESS_TOKEN_MAX_AGE_SECONDS=900
REFRESH_TOKEN_MAX_AGE_SECONDS=604800
SESSION_COOKIE_NAME=verion_session
REFRESH_COOKIE_NAME=verion_refresh
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GitHub OAuth App credentials — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback
# Required when ENVIRONMENT=production. Optional in development.
GITHUB_WEBHOOK_SECRET=

# LLM — optional; enables AI explanations for scanner findings (not scores)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
